<resources>
    <style name="Theme.PlainPlayer" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!-- Same dark as the app itself: no grey flash while the app starts. -->
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:colorAccent">#D7FF64</item>
        <item name="android:navigationBarColor">#101110</item>
        <item name="android:statusBarColor">#101110</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
